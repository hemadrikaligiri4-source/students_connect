# StudyLoop Environment Variable Configuration (Template)
# Rename this file to .env and configure keys. DO NOT commit actual secrets to git!

# 1. Server Configuration
PORT=8080

# 2. Database Connection (Supabase Postgres or Neon)
# Syntax: jdbc:postgresql://<host>:<port>/<dbname>
DATABASE_URL=jdbc:postgresql://db.xxxxxx.supabase.co:5432/postgres
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_database_password_here

# 3. Redis Configurations (Upstash Redis Free-tier)
# Host and port can be found in the Upstash console details page
REDIS_HOST=xxxxxx.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your_upstash_redis_password_here
REDIS_SSL=true

# 4. Supabase JWT Authentication Secrets
# Can be retrieved under Project Settings -> API in the Supabase Dashboard
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_signing_key_here
# Set to true in staging/production to enforce cryptographic signature verification
SUPABASE_JWT_VERIFY=false

# 5. Cloudflare R2 File Storage (S3-compatible API credentials)
# zero egress billing configuration details
R2_ENDPOINT_URL=https://xxxxxx.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key_here
R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_key_here
R2_BUCKET_NAME=studyloop-assets
